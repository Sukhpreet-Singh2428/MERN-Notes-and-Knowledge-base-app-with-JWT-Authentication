# ── Hearth Notes Backend – Environment Variables ─────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hearth_notes?retryWrites=true&w=majority

# ── JWT Authentication ───────────────────────────────────────────────────
# Generate a strong random secret (minimum 32 characters recommended):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── Frontend (CORS) ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
